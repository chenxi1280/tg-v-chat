# Runtime
APP_ENV=production
TZ=Asia/Shanghai

# PostgreSQL from infra-compose, not app-owned PostgreSQL.
# infra-compose creates app_user with CREATEDB; deploy ensures tg_v_chat database exists.
TG_V_CHAT_DATABASE_URL=postgresql+psycopg://app_user:replace_with_shared_app_password@postgres:5432/tg_v_chat?connect_timeout=3

# Security
TG_V_CHAT_SESSION_KEY=replace_with_32_plus_char_random_secret
TG_V_CHAT_BOT_TOKEN=replace_with_telegram_bot_token

# Telegram Developer App Slots
TG_V_CHAT_PRIMARY_API_ID=replace_with_primary_api_id
TG_V_CHAT_PRIMARY_API_HASH=replace_with_primary_api_hash
TG_V_CHAT_STANDBY_1_API_ID=replace_with_standby_1_api_id
TG_V_CHAT_STANDBY_1_API_HASH=replace_with_standby_1_api_hash
TG_V_CHAT_STANDBY_2_API_ID=replace_with_standby_2_api_id
TG_V_CHAT_STANDBY_2_API_HASH=replace_with_standby_2_api_hash
TG_V_CHAT_MEDIA_ROOT=/var/lib/tg-v-chat/media
TG_V_CHAT_HEARTBEAT_ROOT=/var/run/tg-v-chat
TG_V_CHAT_NATIVE_FORWARD_V2_ENABLED=false
TG_V_CHAT_BOT_USERNAME=
TG_V_CHAT_NATIVE_FORWARD_BRIDGE_TIMEOUT_SECONDS=30

# Deployment
TG_V_CHAT_IMAGE=ghcr.io/owner/tg-v-chat:replace_with_git_sha
INFRA_NETWORK_NAME=infra_default
